# Copy to config.env and fill in.  config.env is gitignored — keep credentials out of git.

# --- XNAT connection ---
XNAT_URL=https://localhost
XNAT_USER=admin
XNAT_PASS=changeme
# XNAT_INSECURE=1        # uncomment for self-signed certs (adds: curl -k)

# --- What to transfer ---
SOURCE_SESSION_ID=XNAT_E00001    # submit-anon-transfer.sh: single source image session accession/ID
SOURCE_PROJECT=SRC_PROJECT       # reimport-project.sh: reimport ALL image sessions in this project
DEST_PROJECT=ANON_TARGET         # destination project; you need EDIT access (use a scratch project)

# --- Optional ---
# ANON_SCRIPT_FILE=./anonymize.des       # static custom DicomEdit script (submit-anon-transfer.sh)
# TRACKING_ID=                            # default: anon_validation_<timestamp>
# POLL_INTERVAL=5                         # seconds between polls
# POLL_TIMEOUT=600                        # seconds before giving up

# --- ${csv.*} substitution (submit-csv-anon-transfer.sh) ---
# CSV_ANON_SCRIPT_FILE=./anonymize-csv.des  # ${csv.*} template (defaults to the bundled sample)
# CSV_STUDY_DESC=CSV_ANON_OK                # value substituted into StudyDescription (the verify sentinel)
# CSV_PATIENT_ID=ANON_CSV_042               # value substituted into PatientID; must pass A-Za-z0-9 ^_.-
# ANON_REPLACE_PIPELINE=1                   # also send anon_replace_pipeline=true (suppress site/project anon)
