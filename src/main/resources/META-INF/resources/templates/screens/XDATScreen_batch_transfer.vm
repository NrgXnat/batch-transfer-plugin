<script type="text/javascript" src="$!content.getURI("scripts/xnat/plugin/batchTransfer/batchTransfer.js")"></script>
<script type="text/javascript" src="$!content.getURI("scripts/xnat/plugin/batchTransfer/batchTransferHistory.js")"></script>
<script type="text/javascript" src="$!content.getURI("scripts/xnat/plugin/batchTransfer/batchTransferHelp.js")"></script>
<script type="text/javascript" src="$!content.getURI("scripts/subjectAssessorData/proj_tools.js")"></script>

#if($msg)
    <div class="info">$msg</div>
#end

#if($historyOnly)
## History only: opened with no project and no search (the Tools menu, a link, or a reload once the session's search
## is gone), so there is nothing to transfer. batchTransferHistory.js renders the runs; site admins can list them all.
<div class="bt-pagehead">
    <div class="bt-pagehead-title">
        <h1>Batch Transfer</h1>
        <span class="bt-pagehead-ctx">History</span>
    </div>
</div>
<p class="bt-summary bt-h-only-note">To start a transfer, open Batch Transfer from a project's Actions menu, or from search results.</p>
<div class="bt-view" id="bt-view-history">
    <div class="bt-h-screen" id="bt-history"></div>
</div>
<script type="text/javascript">
    $(function() {
        XNAT.plugin.batchtransfer.history.init({
            projectContext: null,
            historyOnly: true,
            siteAdmin: #if($siteAdmin) true #else false #end
        });
    });
</script>
#elseif(!$items || $items.size() == 0)
    #if($sharingMsg)
        <div class="info">$sharingMsg</div>
    #end
    <br>
    <input type="button" name="ok" value="Ok" onclick="goHome()"/>
    <script type="text/javascript">
        function goHome(){ window.location.href = serverRoot + "/"; }
    </script>
#else

## The source project: the one the screen was opened from, which the screen class sets. From search results, the
## project that owns every listed item, if one does. Items are grouped by owning project, so a project's own screen
## can list several groups when subjects are shared into it.
#if(!$projectContext)
    #set($projectContext = false)
    #if($items && $items.size() == 1)
        #foreach($proj in $items)
            #set($projectContext = $proj.getId())
        #end
    #end
#end

## Determine if we have a preset destination
#set($hasPresetDest = false)
#if($presetDestination && $presetDestination != "")
    #set($hasPresetDest = true)
#end

## Page header: the title, the source, and the New transfer / History tabs. The tabs switch two panels;
## switching only hides a panel, so New transfer keeps its state. batchTransferHistory.js drives the tabs and
## renders the History panel.
<div class="bt-pagehead">
    <div class="bt-pagehead-title">
        <h1>Batch Transfer</h1>
        <span class="bt-pagehead-ctx">#if($projectContext)$displayManager.getSingularDisplayNameForProject() <strong>$!projectContext</strong>#{else}Search results#end</span>
    </div>
    <div class="bt-viewtabs" role="tablist" aria-label="Batch Transfer views">
        <button type="button" class="bt-viewtab" role="tab" id="bt-tab-transfer" data-view="transfer"
                aria-selected="true" aria-controls="bt-view-transfer">New transfer</button>
        <button type="button" class="bt-viewtab" role="tab" id="bt-tab-history" data-view="history"
                aria-selected="false" aria-controls="bt-view-history" tabindex="-1">History
            <span class="bt-live" id="bt-history-badge" hidden><span class="bt-live-dot"></span><span id="bt-history-badge-text"></span></span>
        </button>
    </div>
</div>

## New transfer: a help column on the left, with a topic per section, and on the right the summary, a setup card
## (Transfer, Operation, Anonymization), the Reimport script editor and the cohort builder; a full-width action bar
## sits below both. batchTransferHelp.js drives the help column; the ids and classes below are the hooks
## batchTransfer.js drives. Velocity parses the whole template, HTML comments included, so author notes use ##.
<div class="bt-view" id="bt-view-transfer" role="tabpanel" aria-labelledby="bt-tab-transfer">
<div class="bt-screen">

    <div class="bt-body">

        <aside class="bt-help" aria-label="Help">
            <div class="bt-help-in">
                <button type="button" class="bt-help-head" id="bt-help-toggle" title="Hide help"
                        aria-expanded="true" aria-controls="bt-help-notes">
                    <span class="bt-help-q" aria-hidden="true">?</span>
                    <span class="bt-help-cap">Help</span>
                    <span class="bt-help-chev bt-help-chev-close" aria-hidden="true">&laquo;</span>
                    <span class="bt-help-chev bt-help-chev-open" aria-hidden="true">&raquo;</span>
                </button>
                <div class="bt-help-notes" id="bt-help-notes">
                    <section class="bt-help-note" data-help="route">
                        <h4 class="bt-help-title">Transfer</h4>
                        <p>Data is transferred from the <b>source</b>, where it lives now, into the <b>destination</b> project. The source is set by where you opened Batch Transfer: a project, or the projects in your search results. The transfer does not change it.</p>
                        <p>Pick the destination from the list. A locked destination was chosen by the page that opened this screen.</p>
                    </section>
                    <section class="bt-help-note" data-help="op">
                        <h4 class="bt-help-title">Operation</h4>
                        <h5>Share</h5>
                        <p>Makes the data visible in the destination. Nothing is copied: the source project still owns it, and changes there show in both.</p>
                        <h5>Clone</h5>
                        <p>An independent copy you can edit separately. Files are hard-linked, so no extra disk space at clone time. Not anonymized.</p>
                        <h5>Reimport</h5>
                        <p>Image sessions only. The DICOM is imported again into the destination and anonymized on the way in, creating new sessions.</p>
                    </section>
                    <section class="bt-help-note" data-help="anon">
                        <h4 class="bt-help-title">Anonymization</h4>
                        <div data-help-ops="Share Clone">
                            <p>Anonymization is only supported for the Reimport operation.</p>
                            <h5 class="bt-help-opname">Share</h5>
                            <p>Transfers the data as-is: neither the site-wide nor the destination project's anonymization script runs. If the destination has anonymization configured, the row warns you.</p>
                            <h5>To anonymize</h5>
                            <p>Choose Reimport. Image sessions are imported again into the destination, and the site-wide and destination project anonymization scripts run on them, each if it is enabled. You can add a custom script as well. Reimport transfers image sessions only.</p>
                        </div>
                        <div data-help-ops="Reimport">
                            <p>How sessions are anonymized and where their labels come from.</p>
                            <h5>Anonymize with</h5>
                            <p><b>Destination only</b> applies the destination's anonymization, which may include the destination project's anonymization script and the site-wide anonymization script, if configured.</p>
                            <p><b>Add custom script</b> applies a DicomEdit 6 script you write here, in addition to those configured scripts, not instead of them.</p>
                            <p class="bt-help-site" id="bt-help-site" hidden></p>
                            <p>If no script is configured and you don't add one, the sessions are not anonymized. The action bar lists the scripts that will run, in order.</p>
                            <h5>Preserve source labels</h5>
                            <p>Use the source's XNAT subject and session labels instead of deriving them from DICOM tags. Anonymization does not change XNAT labels, so a preserved label is kept as it is.</p>
                            <p>A manifest's <code>destination_subject_label</code> and <code>destination_session_label</code> override this per row; sessions from a subject row always take their session label from this setting.</p>
                        </div>
                    </section>
                    <section class="bt-help-note" data-help="script">
                        <h4 class="bt-help-title">Anonymization script</h4>
                        <p>Applied to each session as it is imported, in addition to the configured anonymization scripts, not instead of them. It runs after the site-wide anonymization script and before the destination project's script, when those are configured.</p>
                        <p>Type or paste the script, or load it from a file: click <b>Upload file</b> or drop the file on the panel. Any file name or extension is accepted<span class="bt-script-limit-wrap" hidden>, up to <span class="bt-script-limit"></span>, a limit set by your site administrator</span>. A loaded file replaces what is in the editor; <b>Undo</b> brings it back.</p>
                        <p><code>${csv.column}</code> takes that session's value from the manifest column of the same name.</p>
                        <p><b>Validate</b> checks the script and its placeholders. Submit is blocked while the script has errors.</p>
                    </section>
                    <section class="bt-help-note" data-help="cohort">
                        <h4 class="bt-help-title">Cohort builder</h4>
                        <h5>Select interactively</h5>
                        <p>Tick subjects, sessions and assessors; ticking a subject ticks everything under it. For Reimport only image sessions are listed.</p>
                        <h5>Upload manifest CSV</h5>
                        <p>For Reimport only: Share and Clone use the selection tree, so the button is disabled for them. A manifest needs a source project, so it is also disabled from search results.</p>
                        <p>One row per session, with columns <code>source_subject_label</code> and <code>source_session_label</code>. Leave the session blank to cover a whole subject: all of its image sessions.</p>
                        <p>Rows that match nothing are listed and skipped. The same session listed twice blocks Submit. Optional <code>destination_subject_label</code> and <code>destination_session_label</code> columns set a session's labels in the destination; any other column is a value for the custom script's placeholders.</p>
                        <p class="bt-help-muted">The chips beside Submit show anonymization and storage; hover one for the full explanation.</p>
                    </section>
                </div>
            </div>
        </aside>

        <div class="bt-workspace">
            <div class="bt-work-scroll">

                ## What Batch Transfer does, styled as the page's introduction; batchTransfer.js writes it.
                <p class="bt-summary" id="bt-summary"></p>

                <div class="bt-panel bt-setup">
                    <div class="bt-setup-row" data-sect="route">
                        <div class="bt-setup-lbl">Transfer <button type="button" class="bt-q" data-help-for="route" aria-label="Help: Transfer">?</button></div>
                        <div class="bt-setup-route">
                            <div class="bt-proj-btn frozen">
                                <span class="bt-proj-lbl">Source</span>
                                <span class="bt-proj-name">#if($projectContext)$!projectContext#{else}Multiple ${displayManager.getSingularDisplayNameForProject().toLowerCase()}s#end <span class="bt-proj-ic">&#128274;</span></span>
                            </div>
                            <div class="bt-proj-arrow" aria-hidden="true">&#10142;</div>
                            <div class="bt-proj-btn #if($hasPresetDest)frozen#{else}select#end">
                                <span class="bt-proj-lbl">Destination $displayManager.getSingularDisplayNameForProject()</span>
                                #if($hasPresetDest)
                                    <span class="bt-proj-name">$!turbineUtils.escapeHTML($presetDestination) <span class="bt-proj-ic">&#128274;</span></span>
                                #else
                                    <select class="bt-proj-select" id="bt-project-select" disabled="disabled" aria-label="Destination ${displayManager.getSingularDisplayNameForProject().toLowerCase()}">
                                        <option value="">Select a ${displayManager.getSingularDisplayNameForProject().toLowerCase()}...</option>
                                    </select>
                                #end
                            </div>
                        </div>
                    </div>

                    ## Operation decides what is eligible: the tree hides rows the operation can't transfer, and a
                    ## manifest is for Reimport only.
                    <div class="bt-setup-row" data-sect="op">
                        <div class="bt-setup-lbl">Operation <button type="button" class="bt-q" data-help-for="op" aria-label="Help: Operation">?</button></div>
                        <div class="bt-setup-ops">
                            <div class="bt-op-card-sm selected" data-op="Share">
                                <div class="bt-op-label">Share</div>
                                <div class="bt-op-desc">Add to destination without copying</div>
                            </div>
                            <div class="bt-op-card-sm" data-op="Clone">
                                <div class="bt-op-label">Clone</div>
                                <div class="bt-op-desc">Full data duplication</div>
                            </div>
                            <div class="bt-op-card-sm" data-op="Reimport">
                                <div class="bt-op-label">Reimport</div>
                                <div class="bt-op-desc">Re-anonymize image sessions</div>
                            </div>
                        </div>
                    </div>

                    ## Anonymization, for every operation: Reimport's controls, or for Share and Clone a note that only
                    ## Reimport anonymizes, plus a warning when the destination's anonymization will be bypassed.
                    <div class="bt-setup-row" data-sect="anon">
                        <div class="bt-setup-lbl">Anonymization <button type="button" class="bt-q" data-help-for="anon" aria-label="Help: Anonymization">?</button></div>
                        <div class="bt-setup-anon">
                            <div class="bt-anon-opts" id="bt-anon-band" style="display:none;">
                                <div>
                                    <div class="bt-opt-cap">Anonymize with</div>
                                    <div class="bt-anon-seg" id="bt-anon-seg">
                                        <button type="button" class="bt-anon-mode selected" data-anon="none" title="The destination's anonymization: its project script and the site-wide script, if configured.">Destination only</button>
                                        <button type="button" class="bt-anon-mode" data-anon="script" title="Your own DicomEdit script, applied in addition to the configured anonymization scripts.">Add custom script</button>
                                    </div>
                                    <div class="bt-anon-unsupported" id="bt-anon-unsupported" style="display:none;">
                                        This XNAT build does not support per-import anonymization; Reimport will use the destination's anonymization only.
                                    </div>
                                </div>
                                <div id="bt-reimport-label-option">
                                    <div class="bt-opt-cap">Preserve source labels</div>
                                    <div class="bt-label-checks">
                                        <label><input type="checkbox" id="bt-preserve-subject-label" checked /> Subject</label>
                                        <label><input type="checkbox" id="bt-preserve-session-label" checked /> Session</label>
                                    </div>
                                </div>
                            </div>
                            <div class="bt-anon-na" id="bt-anon-na">
                                <p class="bt-anon-na-text">Anonymization is only supported for the Reimport operation. <span id="bt-anon-na-op">Share</span> transfers the data as-is.</p>
                                <div class="bt-banner-region" id="bt-op-detail-warning-area"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Custom-script editor (Reimport + custom script), full workspace width -->
                <div class="bt-panel bt-anon-editor" id="bt-anon-editor" data-sect="script" style="display:none;">
                    <div class="bt-panel-head">
                        <div class="bt-panel-title">Anonymization script <button type="button" class="bt-q" data-help-for="script" aria-label="Help: Anonymization script">?</button></div>
                        <div class="bt-panel-meta"><span class="bt-mode-pill">DicomEdit 6</span></div>
                    </div>
                    <div class="bt-panel-body">
                        <div class="bt-anon-editor-hint">Applied per session at ingest, in addition to the site-wide and destination anonymization scripts. <code>${csv.column}</code> placeholders bind to manifest columns.</div>
                        ## Load the script from a file: the button, or a file dropped anywhere on this panel.
                        <div class="bt-script-tools">
                            <button type="button" class="bt-btn bt-btn-secondary" id="bt-script-pick">Upload file</button>
                            <span id="bt-script-source">or drop a file on this panel. Any file type.</span>
                            <input type="file" id="bt-script-file" style="display:none;">
                        </div>
                        <div class="bt-verdict-line bt-verdict-bad bt-script-err" id="bt-script-err" role="alert" hidden></div>
                        <textarea id="bt-anon-script" class="bt-anon-textarea" spellcheck="false" placeholder='version "6.1"' aria-label="Anonymization script"></textarea>
                        <div class="bt-anon-editor-row">
                            <button type="button" class="bt-btn bt-btn-secondary" id="bt-anon-validate">Validate</button>
                            <div class="bt-anon-verdict" id="bt-anon-verdict"></div>
                        </div>
                    </div>
                    <div class="bt-drop-over" aria-hidden="true">Drop the file to load it into the editor</div>
                </div>

                <!-- Cohort builder: the mode toggle in its header, and whichever mode is active (interactive tree,
                     or CSV dropzone + resolved table) in its body. Content is flush; the panel is the frame. -->
                <div class="bt-panel bt-builder" data-sect="cohort">
                    <div class="bt-panel-head bt-builder-head">
                        <div class="bt-panel-title">Cohort builder <button type="button" class="bt-q" data-help-for="cohort" aria-label="Help: Cohort builder">?</button></div>
                        <div class="bt-panel-meta" id="bt-builder-mode"></div>
                        <div class="bt-cohort-toggle" id="bt-cohort-toggle" role="group" aria-label="Cohort mode">
                            <button type="button" class="bt-cohort-mode selected" data-cohort="tree">Select interactively</button>
                            <button type="button" class="bt-cohort-mode" data-cohort="csv">Upload manifest CSV</button>
                        </div>
                    </div>

                    <!-- interactive tree (subjects / sessions / assessors) -->
                    <div id="bt-cohort-tree">
                        ## Both eligibility warnings are operation-specific and start hidden;
                        ## batchTransfer.js shows the one matching the selected operation.
                        #if($sharingMsg)
                            <div class="bt-warning" id="bt-share-warning" style="display:none;">
                                <span class="bt-warn-icon">&#9888;</span>
                                <div>$sharingMsg</div>
                            </div>
                        #end
                        #if($copyingMsg)
                            <div class="bt-warning" id="bt-copy-warning" style="display:none;">
                                <span class="bt-warn-icon">&#9888;</span>
                                <div>$copyingMsg</div>
                            </div>
                        #end

                        <div class="bt-builder-tools">
                            <div class="bt-data-toolbar">
                                <input class="bt-data-search" id="bt-data-search" type="text" placeholder="Filter subjects and sessions by name or datatype...">
                            </div>
                            <span class="bt-builder-sel"><strong id="bt-sel-count">0</strong> items selected</span>
                            <button type="button" class="bt-select-all-link">Select all</button>
                        </div>
                        <div class="bt-table-wrap">
                            <table class="bt-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px"><span class="bt-cb checked" id="bt-header-cb">&#10003;</span></th>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>ID</th>
                                    </tr>
                                </thead>
                                <tbody id="bt-data-body">
                                    ## Single item set; per-project share/clone eligibility drives op visibility.
                                    ## Reimport is never feature-gated - all image sessions are reimportable.
                                    #if($items && $items.size() > 0)
                                        #foreach($proj in $items)
                                            #set($projShareable = $shareableProjects.contains($proj.getId()))
                                            #set($projCloneable = $cloneableProjects.contains($proj.getId()))
                                            #foreach($subj in $proj.getChildren())
                                                <tr class="selected" data-type="subject"
                                                    data-id="$!subj.getId()" data-xsi="$!subj.getXsiType()"
                                                    data-project="$!proj.getId()"
                                                    data-shareable="$projShareable" data-cloneable="$projCloneable"
                                                    data-reimportable="$!subj.isReimportable()">
                                                    <td><span class="bt-cb checked">&#10003;</span></td>
                                                    <td>
                                                        #if($subj.getChildren().size() > 0)
                                                            <button class="bt-expand expanded">&#9654;</button>
                                                        #end
                                                        $!subj.getLabel()
                                                    </td>
                                                    <td><span class="bt-type-badge subject">Subject</span></td>
                                                    <td class="bt-id-text">$!subj.getId()</td>
                                                </tr>
                                                #foreach($subj_assess in $subj.getChildren())
                                                    <tr class="bt-indent-1 selected" data-type="assessor"
                                                        data-id="$!subj_assess.getId()" data-xsi="$!subj_assess.getXsiType()"
                                                        data-parent="$!subj.getId()" data-project="$!subj_assess.getProject()"
                                                        data-shareable="$projShareable" data-cloneable="$projCloneable"
                                                        data-reimportable="$!subj_assess.isReimportable()">
                                                        <td><span class="bt-cb checked">&#10003;</span></td>
                                                        <td>
                                                            #if($subj_assess.getChildren().size() > 0)
                                                                <button class="bt-expand expanded">&#9654;</button>
                                                            #end
                                                            $!subj_assess.getLabel()
                                                        </td>
                                                        <td><span class="bt-type-badge assessor">$!subj_assess.getXsiType()</span></td>
                                                        <td class="bt-id-text">$!subj_assess.getId()</td>
                                                    </tr>
                                                    #foreach($img_assess in $subj_assess.getChildren())
                                                        <tr class="bt-indent-2 selected" data-type="assessor"
                                                            data-id="$!img_assess.getId()" data-xsi="$!img_assess.getXsiType()"
                                                            data-parent="$!subj_assess.getId()" data-project="$!img_assess.getProject()"
                                                            data-shareable="$projShareable" data-cloneable="$projCloneable"
                                                            data-reimportable="$!img_assess.isReimportable()">
                                                            <td><span class="bt-cb checked">&#10003;</span></td>
                                                            <td>$!img_assess.getLabel()</td>
                                                            <td><span class="bt-type-badge assessor">$!img_assess.getXsiType()</span></td>
                                                            <td class="bt-id-text">$!img_assess.getId()</td>
                                                        </tr>
                                                    #end
                                                #end
                                            #end
                                        #end
                                    #end
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- CSV manifest upload -->
                    <div id="bt-cohort-csv" style="display:none;">
                        <div class="bt-dropzone" id="bt-dropzone">
                            <div class="bt-dz-ic">&#128228;</div>
                            <div class="bt-dz-big">Drop a manifest CSV here</div>
                            <div class="bt-dz-sm">or <span class="bt-dz-link" id="bt-csv-choose">choose a file</span></div>
                            <div class="bt-dz-sm bt-dz-cols" id="bt-csv-required"></div>
                            <input type="file" id="bt-csv-file" accept=".csv,text/csv" style="display:none;">
                        </div>
                        <div id="bt-csv-results"></div>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- ===================== FULL-WIDTH ACTION BAR ===================== -->
    <div class="bt-action-bar">
        ## The summary absorbs all the overflow - the script renders the status chips and the blocked
        ## reason into it as one wrapping row. Only the buttons are rigid, so they hold the right edge
        ## however much the status has to say.
        <div class="bt-action-summary" id="bt-action-summary"></div>
        <div class="bt-action-controls">
            <button type="button" class="bt-btn bt-btn-secondary" onclick="history.go(-1);">Cancel</button>
            <button type="button" class="bt-btn bt-btn-success" id="bt-submit-btn"
                    onclick="XNAT.plugin.batchtransfer.submitTransfer();">Submit</button>
        </div>
    </div>

</div>
</div>

<div class="bt-view" id="bt-view-history" role="tabpanel" aria-labelledby="bt-tab-history" hidden>
    <div class="bt-h-screen" id="bt-history"></div>
</div>

<script type="text/javascript">
    $(function() {
        XNAT.plugin.batchtransfer.help.init();
        XNAT.plugin.batchtransfer.init({
            projectContext: #if($projectContext) '$!projectContext' #else null #end,
            presetDestination: #if($hasPresetDest) '$!turbineUtils.escapeJS($presetDestination)' #else null #end
        });
        XNAT.plugin.batchtransfer.history.init({
            projectContext: #if($projectContext) '$!projectContext' #else null #end
        });
    });
</script>
#end
