<script type="text/javascript" src="$!content.getURI("scripts/xnat/plugin/batchTransfer/batchTransfer.js")"></script>
<script type="text/javascript" src="$!content.getURI("scripts/subjectAssessorData/proj_tools.js")"></script>

#if($msg)
    <div class="info">$msg</div>
#end

#if(!$items || $items.size() == 0)
    <div class="info">$sharingMsg</div>
    <br>
    <input type="button" name="ok" value="Ok" onclick="goHome()"/>
    <script type="text/javascript">
        function goHome(){ window.location.href = serverRoot + "/"; }
    </script>
#else

## Determine source project context
#set($projectContext = false)
#if($items && $items.size() == 1)
    #foreach($proj in $items)
        #set($projectContext = $proj.getId())
    #end
#end

## Determine if we have a preset destination
#set($hasPresetDest = false)
#if($presetDestination && $presetDestination != "")
    #set($hasPresetDest = true)
#end

<div class="bt-bands">

    <!-- ===== Project selection: Source -> Destination ===== -->
    <div class="bt-proj-bar">
        <div class="bt-proj-btn frozen">
            <span class="bt-proj-lbl">Source</span>
            <span class="bt-proj-name">#if($projectContext)$!projectContext#{else}Multiple ${displayManager.getSingularDisplayNameForProject().toLowerCase()}s#end <span class="bt-proj-ic">&#128274;</span></span>
        </div>
        <span class="bt-proj-arrow">&#10142;</span>
        <div class="bt-proj-btn #if($hasPresetDest)frozen#{else}select#end">
            <span class="bt-proj-lbl">Destination $displayManager.getSingularDisplayNameForProject()</span>
            #if($hasPresetDest)
                <span class="bt-proj-name">$!presetDestination <span class="bt-proj-ic">&#128274;</span></span>
            #else
                <select class="bt-proj-select" id="bt-project-select" disabled="disabled">
                    <option value="">Select a ${displayManager.getSingularDisplayNameForProject().toLowerCase()}...</option>
                </select>
            #end
        </div>
    </div>

    <!-- ===== Operation ===== -->
    <div class="bt-band">
        <div class="bt-band-label">Operation</div>
        <div class="bt-band-row">
            <div class="bt-op-row">
                <div class="bt-op-card-sm selected" data-op="Share">
                    <div class="bt-op-label">Share</div>
                    <div class="bt-op-desc">Add to destination without copying</div>
                </div>
                <div class="bt-op-card-sm" data-op="Clone">
                    <div class="bt-op-label">Clone</div>
                    <div class="bt-op-desc">Full data duplication</div>
                </div>
                <div class="bt-op-card-sm" data-op="Reimport">
                    <div class="bt-op-label">Reimport</div>
                    <div class="bt-op-desc">Re-anonymize image sessions</div>
                </div>
            </div>
        </div>
        <p class="bt-op-detail-desc" id="bt-op-detail-desc"></p>
    </div>

    <!-- ===== Cohort ===== -->
    <div class="bt-band">
        <div class="bt-band-label">Cohort</div>
        <div class="bt-band-row">
            <div class="bt-cohort-toggle" id="bt-cohort-toggle">
                <button type="button" class="bt-cohort-mode selected" data-cohort="tree">Select interactively</button>
                <button type="button" class="bt-cohort-mode" data-cohort="csv">Upload manifest CSV</button>
            </div>
            <span class="bt-band-status" id="bt-cohort-status"></span>
        </div>
    </div>

    <!-- ===== Cohort workspace ===== -->
    <div class="bt-workarea">
        <!-- interactive tree (subjects / sessions / assessors) -->
        <div id="bt-cohort-tree">
            #if($sharingMsg)
                <div class="bt-warning">
                    <span class="bt-warn-icon">&#9888;</span>
                    <div>$sharingMsg</div>
                </div>
            #end
            #if($copyingMsg)
                <div class="bt-warning" id="bt-copy-warning" style="display:none;">
                    <span class="bt-warn-icon">&#9888;</span>
                    <div>$copyingMsg</div>
                </div>
            #end

            <div class="bt-data-toolbar">
                <input class="bt-data-search" id="bt-data-search" type="text" placeholder="Filter subjects and sessions by name or datatype...">
            </div>
            <div class="bt-selection-bar">
                <strong id="bt-sel-count">0</strong> items selected
                <button type="button" class="bt-select-all-link">Select all</button>
            </div>
            <div class="bt-table-wrap">
                <table class="bt-table">
                    <thead>
                        <tr>
                            <th style="width:40px"><span class="bt-cb checked" id="bt-header-cb">&#10003;</span></th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>ID</th>
                        </tr>
                    </thead>
                    <tbody id="bt-data-body">
                        ## Single item set; per-project share/clone eligibility drives op visibility.
                        ## Reimport is never feature-gated - all image sessions are reimportable.
                        #if($items && $items.size() > 0)
                            #foreach($proj in $items)
                                #set($projShareable = $shareableProjects.contains($proj.getId()))
                                #set($projCloneable = $cloneableProjects.contains($proj.getId()))
                                #foreach($subj in $proj.getChildren())
                                    <tr class="selected" data-type="subject"
                                        data-id="$!subj.getId()" data-xsi="$!subj.getXsiType()"
                                        data-project="$!proj.getId()"
                                        data-shareable="$projShareable" data-cloneable="$projCloneable"
                                        data-reimportable="$!subj.isReimportable()">
                                        <td><span class="bt-cb checked">&#10003;</span></td>
                                        <td>
                                            #if($subj.getChildren().size() > 0)
                                                <button class="bt-expand expanded">&#9654;</button>
                                            #end
                                            $!subj.getLabel()
                                        </td>
                                        <td><span class="bt-type-badge subject">Subject</span></td>
                                        <td class="bt-id-text">$!subj.getId()</td>
                                    </tr>
                                    #foreach($subj_assess in $subj.getChildren())
                                        <tr class="bt-indent-1 selected" data-type="assessor"
                                            data-id="$!subj_assess.getId()" data-xsi="$!subj_assess.getXsiType()"
                                            data-parent="$!subj.getId()" data-project="$!subj_assess.getProject()"
                                            data-shareable="$projShareable" data-cloneable="$projCloneable"
                                            data-reimportable="$!subj_assess.isReimportable()">
                                            <td><span class="bt-cb checked">&#10003;</span></td>
                                            <td>
                                                #if($subj_assess.getChildren().size() > 0)
                                                    <button class="bt-expand expanded">&#9654;</button>
                                                #end
                                                $!subj_assess.getLabel()
                                            </td>
                                            <td><span class="bt-type-badge assessor">$!subj_assess.getXsiType()</span></td>
                                            <td class="bt-id-text">$!subj_assess.getId()</td>
                                        </tr>
                                        #foreach($img_assess in $subj_assess.getChildren())
                                            <tr class="bt-indent-2 selected" data-type="assessor"
                                                data-id="$!img_assess.getId()" data-xsi="$!img_assess.getXsiType()"
                                                data-parent="$!subj_assess.getId()" data-project="$!img_assess.getProject()"
                                                data-shareable="$projShareable" data-cloneable="$projCloneable"
                                                data-reimportable="$!img_assess.isReimportable()">
                                                <td><span class="bt-cb checked">&#10003;</span></td>
                                                <td>$!img_assess.getLabel()</td>
                                                <td><span class="bt-type-badge assessor">$!img_assess.getXsiType()</span></td>
                                                <td class="bt-id-text">$!img_assess.getId()</td>
                                            </tr>
                                        #end
                                    #end
                                #end
                            #end
                        #end
                    </tbody>
                </table>
            </div>
        </div>

        <!-- CSV manifest upload (wired in a later build step) -->
        <div id="bt-cohort-csv" style="display:none;">
            <div class="bt-dropzone">
                <div class="bt-dz-ic">&#128228;</div>
                <div class="bt-dz-big">Drop a manifest CSV here</div>
                <div class="bt-dz-sm">Manifest upload is set up in the next build step.</div>
            </div>
        </div>
    </div>

    <!-- ===== Anonymization (Reimport only) ===== -->
    <div class="bt-band" id="bt-anon-band" style="display:none;">
        <div class="bt-band-label">Anonymization</div>
        <div class="bt-band-row" id="bt-anon-band-row">
            <span class="bt-anon-placeholder">Image sessions are anonymized by the destination's anonymization on reimport. Custom per-import scripts are set up in a later build step.</span>
        </div>
    </div>

    <!-- ===== Banner region: anon status + storage caution (rendered by batchTransfer.js) ===== -->
    <div class="bt-banner-region" id="bt-op-detail-warning-area"></div>

    <!-- ===== Summary + submit ===== -->
    <div class="bt-action-bar">
        <!-- Reimport only: preserve source XNAT labels instead of deriving them from DICOM tags -->
        <div id="bt-reimport-label-option" class="bt-reimport-opts" style="display:none;">
            <div class="bt-label-options-title">Preserve source labels</div>
            <p class="bt-label-options-help">Use the source's XNAT subject/session labels instead of deriving them from DICOM tags.</p>
            <div class="bt-label-checks">
                <label><input type="checkbox" id="bt-preserve-subject-label" checked /> Subject</label>
                <label><input type="checkbox" id="bt-preserve-session-label" checked /> Session</label>
            </div>
        </div>
        <div class="bt-action-main">
            <div class="bt-action-summary">
                <strong id="bt-sum-op">Share</strong> to <strong id="bt-sum-dest">-</strong>
                <span class="bt-sum-counts"><span id="bt-sum-subjects">0</span> subjects, <span id="bt-sum-sessions">0</span> sessions, <span id="bt-sum-assessors">0</span> assessors</span>
            </div>
            <span class="bt-spacer"></span>
            <button type="button" class="bt-btn bt-btn-secondary" onclick="history.go(-1);">Cancel</button>
            <button type="button" class="bt-btn bt-btn-success" id="bt-submit-btn"
                    onclick="XNAT.plugin.batchtransfer.submitTransfer();">Share</button>
        </div>
    </div>

</div>

<script type="text/javascript">
    $(function() {
        XNAT.plugin.batchtransfer.init({
            projectContext: #if($projectContext) '$!projectContext' #else null #end,
            presetDestination: #if($hasPresetDest) '$!presetDestination' #else null #end
        });
    });
</script>
#end
